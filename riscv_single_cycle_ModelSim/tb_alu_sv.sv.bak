`timescale 1ns/1ps

import holy_core_pkg::*;

module tb_alu;

    // Khai báo các tín hi?u k?t n?i v?i ALU
    logic [3:0]  alu_control;
    logic [31:0] src1;
    logic [31:0] src2;
    logic [31:0] alu_result;
    logic        zero;
    logic        last_bit;

    // Kh?i t?o (instantiate) module ALU
    alu u_dut (
        .alu_control(alu_control),
        .src1(src1),
        .src2(src2),
        .alu_result(alu_result),
        .zero(zero),
        .last_bit(last_bit)
    );

    // K?ch b?n t?o xung kích thích (Stimulus) ?? quan sát d?ng sóng
    initial begin
        // Kh?i t?o giá tr? ban ??u
        alu_control = 4'b0000;
        src1 = 32'd0;
        src2 = 32'd0;
        #10;

        // 1. Test phép c?ng (ADD): 15 + 25 = 40
        src1 = 32'd15;
        src2 = 32'd25;
        alu_control = ALU_ADD;
        #20;

        // 2. Test phép tr? (SUB): 50 - 20 = 30
        src1 = 32'd50;
        src2 = 32'd20;
        alu_control = ALU_SUB;
        #20;

        // 3. Test phép AND bitwise: 0x0F0F & 0x3333
        src1 = 32'h00000F0F;
        src2 = 32'h00003333;
        alu_control = ALU_AND;
        #20;

        // 4. Test phép OR bitwise: 0x0F0F | 0x3333
        alu_control = ALU_OR;
        #20;

        // 5. Test so sánh nh? h?n (SLT): 10 < 20 (K?t qu? = 1)
        src1 = 32'd10;
        src2 = 32'd20;
        alu_control = ALU_SLT;
        #20;

        // 6. Test d?ch trái logic (SLL): 1 << 4 = 16
        src1 = 32'd1;
        src2 = 32'd4; // shamt = 4
        alu_control = ALU_SLL;
        #20;

        // 7. Test d?ch ph?i s? h?c (SRA): -8 >>> 1
        src1 = -32'd8;
        src2 = 32'd1;
        alu_control = ALU_SRA;
        #20;

        // K?t thúc mô ph?ng
        $stop;
    end

endmodule
