/*
* MEMORY
*
* BRH 10/24
*
* Simple memory array to remember program or instruction data.
* Has a simple cpu request interface. Supports byte_enable masks.
*/

`timescale 1ns/1ps

module memory #(
    parameter int WORDS = 128,              // Kich thuoc mang bo nho (so luong tu 32-bit)
    parameter string mem_init = ""          // Duong dan file hex khoi tao
) (
    input  logic        clk,
    input  logic [31:0] address,
    input  logic [31:0] write_data,
    input  logic [3:0]  byte_enable,
    input  logic        write_enable,
    input  logic        rst_n,
    output logic [31:0] read_data
);

// Mang bo nho gom cac tu 32-bit
reg [31:0] mem [WORDS];

// Khai bao bien chay cho vong lap ngoai khoi luon (tranh loi bien cuc bo trong for)
integer i;

// Khoi tao du lieu cho bo nho tu file hex neu co duong dan
initial begin
    if (mem_init != "") begin
        $readmemh(mem_init, mem);
    end
end

// Qua trinh ghi du lieu vao bo nho theo suon len cua xung clock
always @(posedge clk) begin
    if (rst_n == 1'b0) begin
        // Reset toan bo mang bo nho ve 0
        for (i = 0; i < WORDS; i = i + 1) begin
            mem[i] <= 32'd0;
        end
    end else begin
        if (write_enable) begin
            // Kiem tra lech dia chi (misaligned)
            if (address[1:0] != 2'b00) begin
                $fatal(1, "STOPPING SIMULATION: Misaligned write at address %h. HINT: Check your code.", address);
            end else begin
                // Su dung byte-enable de ghi chon loc tung byte
                for (i = 0; i < 4; i = i + 1) begin
                    if (byte_enable[i]) begin
                        /* verilator lint_off WIDTHTRUNC */
                        mem[address[31:2]][(i*8)+:8] <= write_data[(i*8)+:8];
                        /* verilator lint_on WIDTHTRUNC */
                    end
                end
            end
        end
    end
end

// Qua trinh doc du lieu tu bo nho (ket hop to hop)
always_comb begin
    read_data = 32'h00000000;
    if (address[1:0] != 2'b00) begin
        $fatal(1, "STOPPING SIMULATION: Misaligned read at address %h. HINT: Check your code.", address);
    end else begin
        /* verilator lint_off WIDTHTRUNC */
        read_data = mem[address[31:2]];
        /* verilator lint_on WIDTHTRUNC */
    end
end

endmodule
